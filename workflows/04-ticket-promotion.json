    {
      "parameters": {
        "jsCode": "\nconst record = $input.first().json;\nconst requestedId = $(\"Promotion Input\").first().json.ticket_id;\n\nconst allowedCategories = [\n  \"billing\", \"technical\", \"delivery\", \"other\"\n];\n\nconst teamMap = {\n  billing: \"Finance\",\n  technical: \"Technical Support\",\n  delivery: \"Logistics\",\n  other: \"Customer Support\"\n};\n\nconst approvedStatuses = [\n  \"approved\",\n  \"approved_corrected\"\n];\n\nconst errors = [];\n\nif (!record.ticket_id || record.ticket_id !== requestedId) {\n  errors.push(\"Review ticket not found\");\n}\n\nif (!approvedStatuses.includes(record.review_status)) {\n  errors.push(\"Ticket is not eligible for promotion\");\n}\n\nconst category = String(record.reviewed_category ?? \"\")\n  .trim()\n  .toLowerCase();\n\nif (!allowedCategories.includes(category)) {\n  errors.push(\"Invalid reviewed category\");\n}\n\nif (\n  typeof record.message !== \"string\" ||\n  !record.message.trim()\n) {\n  errors.push(\"Missing customer message\");\n}\n\nif (\n  typeof record.customer_name !== \"string\" ||\n  !record.customer_name.trim()\n) {\n  errors.push(\"Missing customer name\");\n}\n\nreturn [{\n  json: {\n    ticket_id: requestedId,\n    customer_name: record.customer_name ?? \"\",\n    message: record.message ?? \"\",\n    category,\n    assigned_team: teamMap[category] ?? \"\",\n    ticket_status: \"routed\",\n    previous_review_status: record.review_status,\n    promotion_valid: errors.length === 0,\n    promotion_errors: errors\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
