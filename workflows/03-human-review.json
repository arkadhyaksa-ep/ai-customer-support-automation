    {
      "parameters": {
        "jsCode": "\nconst input = $(\"Reviewer Input\").first().json;\nconst record = $input.first().json;\n\nconst errors = [];\nconst allowed = [\"billing\", \"technical\", \"delivery\", \"other\"];\nconst decisions = [\"approve\", \"correct\", \"reject\"];\n\nconst decision = String(input.decision ?? \"\").trim().toLowerCase();\nconst corrected = String(input.corrected_category ?? \"\").trim().toLowerCase();\n\nif (!record.ticket_id || record.ticket_id !== input.ticket_id) {\n  errors.push(\"Ticket not found\");\n}\n\nif (record.review_status !== \"pending_review\") {\n  errors.push(\"Ticket is not pending review\");\n}\n\nif (!decisions.includes(decision)) {\n  errors.push(\"Unsupported reviewer decision\");\n}\n\nif (decision === \"correct\" && !allowed.includes(corrected)) {\n  errors.push(\"Invalid corrected category\");\n}\n\nif (decision === \"approve\" && !allowed.includes(record.ai_category)) {\n  errors.push(\"Original AI category is invalid\");\n}\n\nconst finalCategory =\n  decision === \"correct\" ? corrected :\n  decision === \"approve\" ? record.ai_category :\n  \"\";\n\nconst finalStatus =\n  decision === \"correct\" ? \"approved_corrected\" :\n  decision === \"approve\" ? \"approved\" :\n  \"rejected\";\n\nreturn [{\n  json: {\n    ticket_id: input.ticket_id,\n    decision_valid: errors.length === 0,\n    decision_errors: errors,\n    review_status: finalStatus,\n    reviewed_category: finalCategory,\n    reviewer_note: input.reviewer_note ?? \"\",\n    reviewed_at: new Date().toISOString()\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
