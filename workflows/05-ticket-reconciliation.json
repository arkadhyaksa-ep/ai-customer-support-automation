    {
      "parameters": {
        "jsCode": "\nconst requestedId = $(\"Recovery Input\").first().json.ticket_id;\n\nconst review = $(\"Find Review Record\").first().json;\nconst main = $(\"Find Main Ticket\").first().json;\n\nconst teamMap = {\n  billing: \"Finance\",\n  technical: \"Technical Support\",\n  delivery: \"Logistics\",\n  other: \"Customer Support\"\n};\n\nconst errors = [];\n\nif (review.ticket_id !== requestedId) {\n  errors.push(\"Review record not found\");\n}\n\nif (main.ticket_id !== requestedId) {\n  errors.push(\"Main ticket not found\");\n}\n\nif (![\"approved\", \"approved_corrected\"].includes(review.review_status)) {\n  errors.push(\"Review is not awaiting promotion\");\n}\n\nconst category = String(review.reviewed_category ?? \"\")\n  .trim().toLowerCase();\n\nif (!Object.hasOwn(teamMap, category)) {\n  errors.push(\"Invalid reviewed category\");\n}\n\nif (main.category !== category) {\n  errors.push(\"Main category does not match approved category\");\n}\n\nif (main.customer_name !== review.customer_name ||\n    main.message !== review.message) {\n  errors.push(\"Main ticket content differs from review record\");\n}\n\nif (main.assigned_team !== teamMap[category]) {\n  errors.push(\"Assigned team differs from approved category\");\n}\n\nconst safeToRecover = errors.length === 0;\n\nreturn [{\n  json: {\n    ticket_id: requestedId,\n    safe_to_recover: safeToRecover,\n    errors,\n    previous_review_status: review.review_status,\n    event_id: `${requestedId}:promotion_recovered`,\n    event_type: \"promotion_recovered\",\n    details: \"Main ticket verified; review status reconciled\",\n    recorded_at: new Date().toISOString()\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
